# Modelo do ambiente de produção.
#
# Na VPS:  cp .env.prod.example .env  e preencha os campos vazios.
# O .env real nunca vai para o Git (já está no .gitignore).

# ---------- Django ----------

# Gere uma chave nova e exclusiva desta instalação:
#   docker run --rm python:3.13-slim python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Domínios que o Django aceita atender, separados por vírgula e SEM esquema.
# Com DEBUG=False e esta lista errada, toda requisição responde 400.
ALLOWED_HOSTS=clinica.exemplo.com.br

# Origem do frontend, COM esquema. Usada para CORS e para o CSRF do /admin.
FRONTEND_ORIGINS=https://clinica.exemplo.com.br

TIME_ZONE=America/Sao_Paulo

# ---------- Banco ----------

DB_NAME=clinica
DB_USER=clinica

# Senha longa e aleatória — o banco não fica exposto, mas esta senha também
# protege o dump de backup. Gere com:
#   openssl rand -base64 32
DB_PASSWORD=

# ---------- Caddy (HTTPS automático) ----------

# O domínio, sem esquema: o Caddy emite o certificado sozinho.
# Para testar na máquina local, use  http://localhost  (desliga o TLS).
SITE_ADDRESS=clinica.exemplo.com.br

# E-mail para os avisos do Let's Encrypt.
ACME_EMAIL=voce@exemplo.com.br
